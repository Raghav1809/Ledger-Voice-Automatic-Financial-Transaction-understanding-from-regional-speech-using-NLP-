SECRET_KEY=django-insecure-voicekhata-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (Defaults to SQLite if DB_NAME is empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=voicekhata_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Gemini API Key for Voice Parsing
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
